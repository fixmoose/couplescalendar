# Copy to .env.local and fill in. Never commit the real values.

# Canonical public URL — used for invite links and metadata.
NEXT_PUBLIC_APP_URL=https://calendar.docmaker.studio

# Supabase → Project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only — bypasses row level security, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# UniOne (US region) — transactional email for invitations.
# The sender domain must be verified at UniOne and must NOT be
# calendar.docmaker.studio: that name is a CNAME to Vercel, and a CNAME cannot
# coexist with the SPF/DKIM/TXT records verification needs.
# https://us1.unione.io → Settings → API keys
UNIONE_API_KEY=
UNIONE_FROM_EMAIL=no-reply@docmaker.studio
UNIONE_FROM_NAME=CouplesCalendar

# Protects /api/cron/sync-feeds — any random string you choose, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Vercel Cron sends it automatically as a bearer token once it is set.
CRON_SECRET=

# Browser push (Web Push / VAPID). Generate a pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@docmaker.studio
